@model IEnumerable<Sklep_Internetowy.Models.Zamowienium>

@{
    ViewData["Title"] = "Zamówienie";
}

<h1>Zamówienie</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DataZamowienia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdresWysylki)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImieNazwiskoKlienta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WartoscCalkowita)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DataZamowienia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdresWysylki)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImieNazwiskoKlienta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WartoscCalkowita)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ZamowienieId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ZamowienieId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ZamowienieId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
