@model IEnumerable<Sklep_Internetowy.Models.Produkty>

@{
    ViewData["Title"] = "Produkty";
}

<h1>Nasze produkty</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nazwa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cena)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kategoria)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nazwa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cena)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opis)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kategoria.Nazwa)
            </td>
            <td>
                <a asp-controller="Zamowienia" asp-action="Create" asp-route-produktId="@item.ProduktId" class="btn btn-success btn-sm">Kup teraz</a>
                <a asp-action="Details" asp-route-id="@item.ProduktId" class="btn btn-info btn-sm">Details</a>
                <span>|</span>
                <a asp-action="Edit" asp-route-id="@item.ProduktId">Edit</a>

                @if (User.IsInRole("Admin"))
                {
                    

                    <span>|</span>
                    <a asp-action="Delete" asp-route-id="@item.ProduktId" class="text-danger">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
