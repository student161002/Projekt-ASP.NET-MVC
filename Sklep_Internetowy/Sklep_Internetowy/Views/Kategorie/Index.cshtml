@model IEnumerable<Sklep_Internetowy.Models.Kategorie>

@{
    ViewData["Title"] = "Kategorie";
}

<h1>Kategorie</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nazwa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Opis)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nazwa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Opis)
            </td>
            <td>
                    <a asp-controller="Produkty" asp-action="Index" asp-route-kategoriaId="@item.KategoriaId">Zobacz produkty</a> |
                @if(User.IsInRole("Admin")){
                    <a asp-action="Edit" asp-route-id="@item.KategoriaId">Edit</a> 
                    <a asp-action="Delete" asp-route-id="@item.KategoriaId">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
